package com.basics;

public class Main {
	public static void main(String[] args) {
		
		int n = 12;
		int sqrt = (int)Math.sqrt(n);
		int res = n;
		for(int i=2; i<=sqrt; i++) {
			if(n%i == 0) {
				while(n%i == 0) {
					n = n/i;
				}
				res = res - res/i;
			}	
		}
		if(n > 1) {
			res = res - res/n;
		}
		System.out.println(res);
		
		
	}
}
