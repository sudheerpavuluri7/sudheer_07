3)Using Modulus(Euclids Algorithm)

package com.basics;

public class Main {
    public static void main(String[] args) {

        int a = 10;
        int b = 15;

        /*
         * Euclidean Algorithm:
         *
         * HCF(a, b) = HCF(b, a % b  --> replace a = b  and b = a%b
         *
         * Continue until b becomes 0.
         * At that point, a contains the HCF.
         */
        while (b != 0) {

            // Find the remainder
            int temp = a % b;

            // Move b into a
            a = b;

            // Move remainder into b
            b = temp;
        }

        /*
         * When b becomes 0,
         * a contains the HCF.
         */
        System.out.println(a);
    }
}
Modulus Time Complexity : O(log(min(a,b)))
