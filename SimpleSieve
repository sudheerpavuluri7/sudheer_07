package com.basics;
public class Main {
	public static void main(String args[])   {
		int n = 64;
		boolean [] primes = new boolean[n+1];

		for(int i=2; i<=Math.sqrt(n); i++) {
			if(primes[i] == false) {
				for(int j=i*i; j<=n; j=j+i) {
					primes[j] = true;
				}
			}
		}
		for(int i=2; i<=n; i++) {
			if(primes[i] == false) {
				System.out.println(i);
			}
		}
	}
}
