package com.basics;

import java.util.ArrayList;
import java.util.List;

public class Main {

	public static void fun(char[] result, int left, int right, List<String> ans) {

		// Base case
		if (left > right) {
			ans.add(new String(result));
			return;
		}

		// Middle character for odd length
		if (left == right) {
			result[left] = '0';
			ans.add(new String(result));

			result[left] = '1';
			ans.add(new String(result));

			result[left] = '8';
			ans.add(new String(result));

			return;
		}

		char[][] pairs = {
				{'0', '0'},
				{'1', '1'},
				{'6', '9'},
				{'8', '8'},
				{'9', '6'}
		};

		for (char[] pair : pairs) {

			// Leading zero is not allowed
			if (left == 0 && pair[0] == '0') {
				continue;
			}

			result[left] = pair[0];
			result[right] = pair[1];

			fun(result, left + 1, right - 1, ans);
		}
	}

	public static void main(String[] args) {
		
		int n = 3;
		char[] result = new char[n];
        List<String> ans = new ArrayList<>();

        fun(result, 0, n - 1, ans);
        System.out.println(ans);

	}
}







