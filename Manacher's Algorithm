package com.basics;
public class Main {
    public static void main(String[] args) {
        String s = "aaaaabaaaaa";
        StringBuilder sb = new StringBuilder("#");
        for (int i = 0; i < s.length(); i++) {
            sb.append(s.charAt(i));
            sb.append("#");
        }
        String str = sb.toString();
        int n = str.length();
        int[] P = new int[n];
        int C = 0, R = 0;
        int maxLen = 0;
        for (int i = 0; i < n; i++) {
            int mirror = 2 * C - i;
            if (i < R) {
                P[i] = Math.min(R - i, P[mirror]);
            }
            while (i + P[i] + 1 < n &&
                   i - P[i] - 1 >= 0 &&
                   str.charAt(i + P[i] + 1) ==
                   str.charAt(i - P[i] - 1)) {
                P[i]++;
            }
            if (i + P[i] > R) {
                C = i;
                R = i + P[i];
            }
            maxLen = Math.max(maxLen, P[i]);
        }
        System.out.println("Longest palindrome length: " + maxLen);
    }
}
