package com.basics;

public class Main {
	
	public static int MInverse(int mi, int Mi) {
		for(int i=1; i<mi; i++) {
			if((Mi * i)%mi == 1) {
				return i;
			}
		}
		return -1;
	}
	
	public static void main(String[] args) {
		int [] m = {3, 4, 5};
		int [] a = {2, 3, 1};
		int M = 1;
		for(int i=0; i<m.length; i++) {
			M *= m[i];
		}
		
		int res = 0;
		for(int i=0; i<m.length; i++) {
			//a1
			int ai = a[i];
			//m1
			int Mi = M/m[i];
			int MiInverse = MInverse(m[i], Mi);
			res = res + (ai * Mi *  MiInverse);
		}
		res = res%M;
		System.out.println(res);
		
		
	}
}
