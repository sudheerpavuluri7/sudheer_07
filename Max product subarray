class Main {
    public static void main(String[] args) {
    	
    	int [] ar = {2,-2,3,4};
    	int max = Integer.MIN_VALUE;
    	for(int i=0; i<ar.length; i++) {
    		for(int j=i; j<ar.length; j++) {
    			int prod = 1;
    			for(int k=i; k<=j; k++) {
    				prod = prod * ar[k];
    			}
    			if(prod > max) {
    				max = prod;
    			}
    		}
    	}
    	System.out.println(max);
    	
    }
}


