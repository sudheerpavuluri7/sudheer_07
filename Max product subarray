package com.basics;

class Main {
    public static void main(String[] args) {
    	
    	int [] ar = {2,0,5,-2,-1,-10,2,3};
    	int max = Integer.MIN_VALUE;
    	int leftProd = 1;
    	for(int i=0; i<ar.length; i++) {
    		leftProd = leftProd * ar[i];
    		if(leftProd > max) {
    			max = leftProd;
    		}	
    		if(leftProd == 0) {
    			leftProd = 1;
    		}
    	}
    	int rightProd = 1;
    	for(int i=ar.length-1; i>=0; i--) {
    		rightProd = rightProd * ar[i];
    		if(rightProd > max) {
    			max = rightProd;
    		}
    		if(rightProd == 0) {
    			rightProd = 1;
    		}
    	}
    	System.out.println(max);
    	
    	
    }
}

—>Optimal 

package com.basics;

class Main {
    public static void main(String[] args) {

        int[] ar = {2, 0, 5, -2, -1, -10, 2, 3};

        int max = Integer.MIN_VALUE;

        int leftProd = 1;
        int rightProd = 1;

        for (int i = 0; i < ar.length; i++) {

            // Left to Right
            leftProd = leftProd * ar[i];

            if (leftProd > max) {
                max = leftProd;
            }

            if (leftProd == 0) {
                leftProd = 1;
            }

            // Right to Left
            rightProd = rightProd * ar[ar.length - 1 - i];

            if (rightProd > max) {
                max = rightProd;
            }

            if (rightProd == 0) {
                rightProd = 1;
            }
        }

        System.out.println(max);
    }
}




