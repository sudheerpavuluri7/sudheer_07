
import java.util.*;

public class Main {

    public static void fun(int[] ar, int k, int ind,
                           ArrayList<Integer> list) {

        if (list.size() == k) {
            System.out.println(list);
            return;
        }

        for (int i = ind; i < ar.length; i++) {

            // Skip duplicate elements at the same level
            if (i > ind && ar[i] == ar[i - 1]) {
                continue;
            }

            list.add(ar[i]);

            fun(ar, k, i + 1, list);

            list.remove(list.size() - 1);
        }
    }

    public static void main(String[] args) {

        int[] ar = {1, 1, 2, 2, 3};
        int k = 2;

        Arrays.sort(ar);

        fun(ar, k, 0, new ArrayList<>());
    }
}
