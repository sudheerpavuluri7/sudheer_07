-->Given an array of n elements and an integer k, reverse the first k elements and the last k elements of the array

import java.util.Scanner;

public class Main {

    static void reverse(int[] arr, int left, int right) {

        while (left < right) {

            int temp = arr[left];
            arr[left] = arr[right];
            arr[right] = temp;

            left++;
            right--;
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int[] arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int k = sc.nextInt();

        // Reverse first k elements
        reverse(arr, 0, k - 1);

        // Reverse last k elements
        reverse(arr, n - k, n - 1);

        // Print array
        for (int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }
    }
}



