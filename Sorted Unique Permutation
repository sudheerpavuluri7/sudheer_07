package com.basics;
import java.util.Arrays;
import java.util.HashMap;
import java.util.Map;
class Main {
    static int factorial(int n) {
        int f = 1;
        for (int i = 1; i <= n; i++) {
            f = f * i;
        }
        return f;
    }
    static void print(char[] ar) {
        for (int i = 0; i < ar.length; i++) {
            System.out.print(ar[i]);
        }
        System.out.println();
    }
    static int calculateTotal(char[] ar, int n) {
        int f = factorial(n);
        HashMap<Character, Integer> map = new HashMap<>();
        for (int i = 0; i < ar.length; i++) {
            map.put(ar[i], map.getOrDefault(ar[i], 0)+1);
        }
        for (Map.Entry<Character, Integer> e : map.entrySet()) {
            int x = e.getValue();
            if (x > 1) {
                f = f / factorial(x);
            }
        }
        return f;
    }
    static void nextPermutation(char[] ar) {
        int n = ar.length;
        int i;
        for (i = n - 2; i >= 0; i--) {
            if (ar[i] < ar[i + 1]) {
                break;
            }
        }
        if (i < 0) {
            return;
        }
        int j = n - 1;
        while (ar[j] <= ar[i]) {
            j--;
        }
        char tempToSwap = ar[i];
        ar[i] = ar[j];
        ar[j] = tempToSwap;
        Arrays.sort(ar, i + 1, n);
        print(ar);
    }
    static void printAllPermutations(String s) {
        char[] ar = s.toCharArray();
        Arrays.sort(ar);
        int total = calculateTotal(ar, ar.length);
        print(ar);
        for (int i = 1; i < total; i++) {
            nextPermutation(ar);
        }
    }
    public static void main(String[] args) {
        String s = “cbaa;
        printAllPermutations(s);
    }
}
